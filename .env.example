# Obsidian Telegram Assistant - Environment Configuration

# ==============================================================================
# REQUIRED
# ==============================================================================

# Telegram bot tokens
# Use separate bots so plain text can mean different things in each chat:
# - journal bot: plain text is saved to Daily/
# - meal bot: plain text is logged as a meal
JOURNAL_TELEGRAM_BOT_TOKEN=1234567890:ABC-journal-token
MEAL_TELEGRAM_BOT_TOKEN=1234567890:ABC-meal-token
# Set to false to keep the bots running without daily/weekly meal summaries.
MEAL_SUMMARIES_ENABLED=true

# Legacy single-bot token. Kept for backwards compatibility until the split-bot
# code is deployed; after that, prefer the two token variables above.
TELEGRAM_BOT_TOKEN=1234567890:ABC-legacy-token
TELEGRAM_ALLOWED_USERS=123456789

# ==============================================================================
# RECOMMENDED
# ==============================================================================

# Obsidian vault root
VAULT_DIR=/Users/yourname/vault

# Default timezone for daily notes (used unless /tz overrides)
VAULT_TIMEZONE=Asia/Kolkata

# Optional overrides (defaults shown)
DAILY_DIR=/Users/yourname/vault/Daily
MEALS_DIR=/Users/yourname/vault/Meals
LINKS_FILE=/Users/yourname/vault/Links.md
BOT_SETTINGS_FILE=/Users/yourname/vault/.bot/settings.json
MEAL_DATA_DIR=/Users/yourname/vault/.bot/meals
MEAL_REFERENCE_FOODS_FILE=/Users/yourname/vault/reference_foods.md

# Claude working directory (defaults to VAULT_DIR if unset)
CLAUDE_WORKING_DIR=/Users/yourname/vault

# Optional meal model override (defaults to claude-sonnet-4-6)
# MEAL_MODEL=claude-sonnet-4-6

# ==============================================================================
# OPTIONAL - Security
# ==============================================================================

# Comma-separated paths Claude can access
# ALLOWED_PATHS=/Users/yourname/vault,/tmp

# Rate limiting (token bucket)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=20
# RATE_LIMIT_WINDOW=60

# ==============================================================================
# OPTIONAL - Anthropic API
# ==============================================================================

# API key for meal analysis and environments without Claude Code CLI auth
ANTHROPIC_API_KEY=sk-ant-api03-...

# ==============================================================================
# OPTIONAL - Logging
# ==============================================================================

# AUDIT_LOG_PATH=/tmp/claude-telegram-audit.log
# AUDIT_LOG_JSON=false
